# ===========================================
# LaserMachine Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Groq API Key (for RAB AI Assistant)
# Get this from: https://console.groq.com/
# NOTE: the code reads VITE_GROQ_API_KEY (see components/CommandAssistant.tsx),
# so the VITE_ prefix is required here.
VITE_GROQ_API_KEY=your_groq_api_key_here

# Remove.bg API Key (for AI background removal)
# Get this from: https://www.remove.bg/api
# Free tier includes 50 API calls per month
VITE_REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Hugging Face API Key (for FREE AI image generation)
# Get this from: https://huggingface.co/settings/tokens
# FREE tier includes monthly credits for inference
VITE_HF_API_KEY=your_huggingface_api_key_here

# Neon PostgreSQL Database URL (optional - for serverless API)
# Get this from your Neon dashboard: https://console.neon.tech/
# Format: postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require
# NEVER use the VITE_ prefix for this variable: VITE_DATABASE_URL would
# expose the full database URL (with password) inside the browser bundle.
# Only plain DATABASE_URL, used server-side (Netlify functions).
DATABASE_URL=postgresql://username:password@ep-xxxxx.us-east-1.aws.neon.tech/lasermachine?sslmode=require

# Supabase (database: products, orders, fonts, store config)
# Get these from your Supabase project: Settings > API
# The anon key is safe to expose in the browser (RLS controls access);
# never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Firebase config (optional - if using Firebase Auth/Storage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=