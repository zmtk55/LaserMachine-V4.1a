# ===========================================
# LaserMachine Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Neon PostgreSQL Database URL
# Get this from your Neon dashboard: https://console.neon.tech/
# Format: postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require
DATABASE_URL=postgresql://username:password@ep-xxxxx.us-east-1.aws.neon.tech/lasermachine?sslmode=require

# For Vite (client-side, only for direct DB access during development)
VITE_DATABASE_URL=postgresql://username:password@ep-xxxxx.us-east-1.aws.neon.tech/lasermachine?sslmode=require

# Optional: Firebase config (if still using Firebase Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
