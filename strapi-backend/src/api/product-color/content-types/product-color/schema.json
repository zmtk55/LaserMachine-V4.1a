{
  "kind": "collectionType",
  "collectionName": "product_colors",
  "info": {
    "singularName": "product-color",
    "pluralName": "product-colors",
    "displayName": "Product Color"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "hex": {
      "type": "string",
      "required": true
    },
    "stock": {
      "type": "integer",
      "default": 0
    },
    "imageUrl": {
      "type": "string"
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    }
  }
}